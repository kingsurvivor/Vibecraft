@charset "utf-8";

* { --primary-color: #666666; --text-color: #000000; }

.modal-container { position: fixed; bottom: 0px; left: 0px; right: 0px; box-sizing: border-box; z-index: var(--z-index-popup); border-top: 1px solid var(--color-border); background: var(--color-banner); padding: 16px; font-family: var(--font-family-sans)
  backdrop-filter: blur(4px); animation: 150ms ease 0s 1 normal none running fadeIn; transition: transform 0.25s cubic-bezier(0.19, 1, 0.22, 1); }

.modal-container-inner { width: 100%; }

.button { width: 100%; background-color: rgba(255, 255, 255, 0.7); opacity: 0.9; border: 1px solid var(--primary-color); box-sizing: border-box; cursor: pointer; filter: brightness(100%); flex-shrink: 0; text-align: center; transition: filter 150ms, background-color 150ms; border-radius: var(--border-radius-300); font-family: var(--font-family-sans); min-width: var(--button-min-width); -webkit-font-smoothing: antialiased; min-height: 30px; padding: 0.25rem 0.6875rem; }

.text-title { grid-area: header; font-size: 16px; font-weight: 700; color: var(--text-color); margin: 0px 0px 18px; text-align: center; }

.paragraph { grid-area: header; color: var(--text-color); font-size: 14px; margin: 0px 0px 18px; }

.complete-options-form { grid-area: options; height: 100%; display: flex; flex-direction: column; width: 100%; margin: 0px auto 2px; justify-content: space-between; align-items: center; }

.button:not(:last-of-type) { margin-bottom: 8px; }

.button:hover { background-color: var(--primary-color); }

.button:hover span { color: rgb(255, 255, 255); }

.button-base-text { color: var(--primary-color); display: block; font-style: normal; text-align: center; transition: color 150ms; }

.button-primary-text { font-size: 12px; font-weight: 700; }

.button-secondary-text { font-size: 9px; font-weight: 400; }

button:focus { outline: rgba(51, 157, 255, 0.7) solid 2px; }

a:focus { outline: rgba(51, 157, 255, 0.7) solid 2px; }

.screen-reader { border: 0px; clip: rect(0px, 0px, 0px, 0px); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; white-space: nowrap; width: 1px; }

.column-content { min-height: 79px; margin: 0px auto; display: flex; flex-direction: column; justify-content: space-evenly; align-items: center; animation: 150ms ease 0s 1 normal none running fadeIn; }

.toggles-container { height: 100%; display: flex; margin: 20px; flex-flow: column wrap; place-content: center; width: 100%; }

.complete-options-container { height: inherit; animation: 200ms ease-in 0s 1 normal none running fadeIn; }

.toggle-label { position: relative; margin: 0px 10px 15px; font-size: 12px; font-weight: 500; height: 16px; vertical-align: baseline; color: var(--text-color); text-shadow: none; padding-left: 25px; overflow-wrap: break-word; }

.toggle-label input:focus + span { outline: rgba(51, 157, 255, 0.7) solid 2px; outline-offset: 1px; }

.toggle-checkmark { display: inline-block; width: 16px; height: 16px; box-sizing: border-box; border-radius: 4px; margin-right: 5px; background: rgba(255, 255, 255, 0.9); border: 1px solid rgb(216, 216, 216); position: absolute; top: 0px; left: 0px; transition: 150ms, background 300ms; cursor: pointer; }

.toggle-checkmark::after { opacity: 0; transform-origin: center bottom; transform: rotate(45deg) scale(0); content: ""; position: absolute; left: 1px; top: 0px; width: 3px; height: 8px; border-style: solid; border-color: rgb(255, 255, 255); border-image: none; border-width: 0px 2px 2px 0px; transition: 150ms cubic-bezier(0.41, 0.94, 0.71, 1.41), opacity 150ms; }

.toggle-input { position: absolute; margin: 0px; top: 0px; left: 0px; width: 100%; height: 100%; opacity: 0; cursor: pointer; }

.toggle-input:disabled { cursor: not-allowed; }

.toggle-input:checked + span { background: var(--primary-color); border-color: transparent; }

.toggle-input:checked + span, .toggle-input:hover + span { filter: brightness(0.9); }

.toggle-input:checked + span::after { opacity: 1; transform: rotate(45deg) scale(1); }

.toggle-input:hover:enabled + span, .toggle-input:focus-visible + span { border-color: var(--primary-color); }

.toggle-input:disabled + span { background-color: rgb(236, 236, 236); cursor: not-allowed; }

.toggle-input:disabled + span, .toggle-input:hover + span { filter: none; border-color: transparent; }

.toggle-input:disabled + span::after { border-color: rgb(216, 216, 216); }

.accept-or-reject-all-button-row { display: flex; flex-direction: column; width: 100%; }

.margin-tops > * { margin-top: 2em; }

.language-options-container { width: 100%; height: 100%; animation: 200ms ease-in 0s 1 normal none running fadeIn; display: flex; flex-flow: wrap; align-items: center; margin: 0px auto; justify-content: space-evenly; }

.language-item-container { padding: 12px; }

.language-button { background: unset; border: unset; padding: unset; margin: unset; width: 17px; height: 17px; overflow: hidden; position: absolute; bottom: 0px; right: 0px; cursor: pointer; }

.language-button-inactive svg { fill: var(--text-color); transition: fill 150ms; }

.language-button-active svg { fill: var(--primary-color); transition: fill 150ms; }

.language-button svg:hover { fill: var(--primary-color); }

.language-button svg:active { fill: var(--primary-color); }

.footer-container { position: absolute; bottom: 21px; width: calc(100% - 42px); height: 17px; }

.bottom-menu-container { width: calc(100% - 60px); height: 100%; display: flex; flex-direction: row; justify-content: space-evenly; align-items: center; margin: 0px auto; }

.bottom-menu-item-container { width: auto; }

.bottom-menu-item { background: unset; border: unset; padding: unset; margin: 0px auto; display: block; min-width: fit-content; width: auto; text-align: center; line-height: 1.5em; font-family: inherit; font-size: 10px; font-weight: 500; color: var(--text-color); transition: text-decoration 150ms; text-decoration: underline 1px rgba(1, 1, 1, 0); text-underline-offset: 2px; }

.bottom-menu-item:hover { cursor: pointer; text-decoration: underline 1px rgb(1, 1, 1); text-underline-offset: 2px; }

.collapsed-square-logo-svg { width: 20px; height: 20px; padding: 6px; flex-shrink: 0; }

.collapsed-square-logo-svg path { fill: var(--text-color); transition: fill 150ms; }

.collapsed-container { position: fixed; bottom: 100px; right: 5px; width: 32px; height: 32px; box-sizing: border-box; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 16px; background-color: rgba(255, 255, 255, 0.95); overflow: hidden; cursor: pointer; padding: 0px; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; font-family: -apple-system, BlinkMacSystemFont, "avenir next", avenir, "helvetica neue", helvetica, "sans-serif"; box-shadow: rgba(0, 0, 0, 0.1) 0px 1px 5px 1px; backdrop-filter: blur(4px) saturate(5); transition: width 150ms ease-in 500ms, background-color 150ms ease-in-out, box-shadow 150ms ease-in-out; }

.collapsed-container:active { background-color: rgba(255, 255, 255, 0.85); box-shadow: rgba(0, 0, 0, 0.12) 0px 0.5px 5px 1.5px; }

.collapsed-container:hover { width: 132px; transition-delay: 0ms; }

.collapsed-container:hover path { fill: var(--primary-color); }

.collapsed-container p { font-size: 12px; font-weight: 500; white-space: nowrap; color: var(--text-color); opacity: 0; transition: opacity 150ms ease-in 500ms; }

.collapsed-container:hover p { opacity: 1; transition-delay: 0ms; }

.inner-container { overflow-y: auto; }

@keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.do-not-sell-explainer-close { --squareDimension: 25px; padding: 4px; position: absolute; top: 21px; right: 21px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; background-color: rgb(242, 242, 242); border-radius: 5px; height: var(--squareDimension); width: var(--squareDimension); display: flex; align-items: center; justify-content: center; transition: background-color 150ms; }

.do-not-sell-explainer-close:hover, .do-not-sell-explainer-close:focus { background-color: rgb(226, 226, 226); }

.do-not-sell-explainer-interface { margin-top: 2em; }

.accept-all-reject-all-toggle-close { --squareDimension: 25px; padding: 4px; position: absolute; top: 21px; right: 21px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; background-color: rgb(242, 242, 242); border-radius: 5px; height: var(--squareDimension); width: var(--squareDimension); display: flex; align-items: center; justify-content: center; transition: background-color 150ms; }

.accept-all-reject-all-toggle-close:hover, .accept-all-reject-all-toggle-close:focus { background-color: rgb(226, 226, 226); }

.privacy-policy-notice-with-close-button-close { --squareDimension: 25px; padding: 4px; position: absolute; top: 21px; right: 21px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; background-color: rgb(242, 242, 242); border-radius: 5px; height: var(--squareDimension); width: var(--squareDimension); display: flex; align-items: center; justify-content: center; transition: background-color 150ms; }

.privacy-policy-notice-with-close-button-close:hover, .privacy-policy-notice-with-close-button-close:focus { background-color: rgb(226, 226, 226); }

.complete-options-toggle-close { --squareDimension: 25px; padding: 4px; position: absolute; top: 21px; right: 21px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; background-color: rgb(242, 242, 242); border-radius: 5px; height: var(--squareDimension); width: var(--squareDimension); display: flex; align-items: center; justify-content: center; transition: background-color 150ms; }

.complete-options-toggle-close:hover, .complete-options-toggle-close:focus { background-color: rgb(226, 226, 226); }

.complete-options-toggle-interface { margin-top: 2em; }

.complete-options-toggle-description { padding-bottom: 2em; }

.gpc-setting { display: flex; align-items: center; margin: 9px 0px; width: 100%; }

.gpc-setting svg { flex-shrink: 0; }

.gpc-setting p { margin: 0px 0px 0px 6px; font-size: 14px; color: var(--text-color); }

.switch { --switchHeight: 20px; --switchGutter: 2px; --switchButtonDiameter: calc(var(--switchHeight) - var(--switchGutter) * 2); }

.switch.label { display: flex; align-items: center; font-weight: 500; font-size: 14px; height: 16px; vertical-align: baseline; text-shadow: none; white-space: nowrap; padding: 0px 5px; }

.switch.switch-background { display: flex; align-items: center; justify-content: space-between; margin-right: 0.8em; cursor: pointer; width: calc(var(--switchHeight) * 2 - 2px); height: var(--switchHeight); background: rgb(126, 135, 147); border-radius: var(--switchHeight); position: relative; transition: background-color 150ms; }

.switch.switch-background .switch.switch-button { content: ""; position: absolute; top: var(--switchGutter); left: var(--switchGutter); width: var(--switchButtonDiameter); height: var(--switchButtonDiameter); border-radius: var(--switchButtonDiameter); transition: 150ms; background: rgb(255, 255, 255); }

.switch.switch-disabled { opacity: 0.6; }

.switch.switch-checkbox:checked + .switch.switch-background .switch.switch-button { left: calc(100% - var(--switchGutter)); transform: translateX(-100%); }

.switch.switch-checkbox:checked + .switch.switch-background { background-color: var(--primary-color); }

.switch.switch-checkbox:focus + .switch.switch-background .switch.switch-button { outline: rgba(51, 157, 255, 0.7) solid 5px; outline-offset: 1px; }

.switch.switch-background:active .switch.switch-button { width: calc(var(--switchButtonDiameter) * 1.2); }

.transcend-logo-container { width: 17px; height: 17px; overflow: hidden; position: absolute; bottom: 0px; left: 0px; }

.transcend-logo-svg { width: 64px; height: 17px; }

.transcend-logo-svg path { fill: var(--text-color); transition: fill 150ms; }

.transcend-logo-svg .transcend-wordmark { fill-opacity: 0; transition: fill 150ms, fill-opacity 150ms; }

@media (min-width: 640px) {
  .button { width: 135px; }
  .paragraph { margin: 18px 18px 0px 0px; }
  .button:not(:last-of-type) { margin-bottom: 0px; }
  .column-content { flex-direction: row; }
  .toggles-container { flex-direction: row; }
  .accept-or-reject-all-button-row { flex-direction: row; }
  .bottom-menu-container { width: calc(100% - 150px); justify-content: space-evenly; }
  .bottom-menu-item { font-size: 12px; }
  .transcend-logo-container { width: 64px; }
  .accept-or-reject-all-button-row button:not(:first-of-type) { margin-left: 10px; }
  .transcend-logo-svg:hover .transcend-wordmark, .transcend-logo-container:focus .transcend-wordmark { fill-opacity: 1; }
  .transcend-logo-svg:hover path, .transcend-logo-container:focus path { fill: var(--primary-color); }
}
